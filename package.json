{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "A auth management service",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "cross-env NODE_ENV=dev nodemon src/server.ts",
    "formate:check": "prettier . --check",
    "formate:write": "prettier . --write",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --no-cache --coverage --all --runInBand",
    "test:watch": "jest --no-cache --coverage --all --watch --runInBand",
    "start": "ts-node src/index.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:run:fake": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts -f",
    "migration:create": "typeorm-ts-node-commonjs migration:create -d src/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts"
  },
  "author": "Sagar",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.11.10",
    "@types/supertest": "^6.0.2",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.5",
    "mock-jwks": "^1.0.9",
    "nodemon": "^3.1.2",
    "prettier": "3.2.5",
    "supertest": "7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "10.9.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run lint:fix",
      "npm run formate:write"
    ]
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-jwt": "^7.7.8",
    "express-validator": "^7.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "rsa-pem-to-jwk": "^1.1.3",
    "typeorm": "0.3.20",
    "uuid": "^14.0.2",
    "winston": "^3.13.0"
  }
}